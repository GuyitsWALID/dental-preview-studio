# Configure the same precreated Supabase user UUID here and in studio_owner.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
STUDIO_OWNER_ID=
# Optional, local development only. Never enabled by the production server.
STUDIO_LOCAL_DEMO=0
# Optional. Enables "Fetch details from Google" in Quick add, scraping a public
# Google Maps listing through Firecrawl (https://firecrawl.dev). Keep it server-side.
FIRECRAWL_API_KEY=
